create_pblock ro_group
add_cells_to_pblock [get_pblocks ro_group] [get_cells -hierarchical -filter {NAME =~ *Generate_RO1*}]

add_cells_to_pblock [get_pblocks ro_group] [get_cells -hierarchical inst_nand]
